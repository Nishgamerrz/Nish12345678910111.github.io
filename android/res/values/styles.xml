<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FF0B0910</color>
    <color name="accent">#FF8B5CF6</color>
    <color name="statusbar">#FF0B0910</color>

    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/statusbar</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/statusbar</item>
        <item name="android:navigationBarColor">@color/statusbar</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
